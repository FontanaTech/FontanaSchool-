{
  "name": "fontana-aula",
  "private": true,
  "version": "2.0.5",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,server \"vite --host 127.0.0.1 --open\" \"tsx server/server.ts --dev\"",
    "dev:net": "concurrently -k -n frontend,server \"vite --host 127.0.0.1 --open\" \"tsx server/server.ts --dev\"",
    "dev:local": "concurrently -k -n frontend,server \"vite --host 127.0.0.1\" \"tsx server/server.ts --dev\"",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:server": "tsx server/server.ts --dev",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "build": "npm run prisma:generate && tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node server-dist/server.js",
    "preview": "vite preview --host 127.0.0.1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "album:optimize": "node scripts/vida-fontana/optimizar-album.mjs",
    "dictation:audio": "tsx server/scripts/generate-dictation-audio.ts",
    "admin:bootstrap": "tsx server/scripts/bootstrap-admin.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:demo:clean": "tsx prisma/seed-demo.ts --clean",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "desktop:instalador": "node scripts/desktop/build.mjs",
    "desktop:publicar": "node scripts/desktop/build.mjs --publish",
    "desktop:actualizacion": "node scripts/desktop/build.mjs --publish --no-installer"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "prisma": "6.19.0",
    "sharp": "^0.35.5",
    "supertest": "7.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "dotenv": "^18.0.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lucide": "^1.58.0",
    "ws": "^8.18.0",
    "zod": "4.6.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
